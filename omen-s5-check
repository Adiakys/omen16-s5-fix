#!/usr/bin/env bash
notify() { notify-send -u critical -i battery-caution "OMEN S5 fix" "$1"; }

if ! grep -q '\[none\]' /sys/kernel/security/lockdown; then
    notify "Secure Boot è attivo senza 'mokutil --disable-validation': il fix non è caricato."
elif [ "$(cat /sys/class/dmi/id/bios_version)" != "$(cat /boot/acpi-omen-s5.bios 2>/dev/null)" ]; then
    notify "BIOS cambiato: il fix è disattivato. Rilancia install.sh."
elif ! journalctl -k -b -q -g 'Table Upgrade: override \[DSDT-HPQOEM-8E35' >/dev/null 2>&1; then
    notify "Il fix non è stato caricato all'avvio."
fi
